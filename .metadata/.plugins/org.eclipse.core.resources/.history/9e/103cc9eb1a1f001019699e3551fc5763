import java.util.*;
import java.io.*;

public class Railroad {

    private int numTracks;
    private String fileName;
    private Edge[] edgeList;
    private Map<String, Integer> nameToIndex = new HashMap<>();
    private List<String> indexToName = new ArrayList<>();

    public Railroad(int numTracks, String fileName) throws Exception {
        this.numTracks = numTracks;
        this.fileName = fileName;
        this.edgeList = new Edge[numTracks];

        BufferedReader br = new BufferedReader(new FileReader(fileName));
        for (int i = 0; i < numTracks; i++) {
            String[] parts = br.readLine().split(" ");
            String src = parts[0];
            String dest = parts[1];
            int weight = Integer.parseInt(parts[2]);

            int srcIndex = getIndex(src);
            int destIndex = getIndex(dest);

            edgeList[i] = new Edge(srcIndex, destIndex, weight);
        }
        br.close();
    }

    public String buildRailroad() {
        Arrays.sort(edgeList);
        StringBuilder sb = new StringBuilder();

        DisjointSet ds = new DisjointSet(indexToName.size());

        int totalCost = 0;
        int count = 0;

        // First pass: gather edges & find max length of src---dest
        List<String[]> chosenEdges = new ArrayList<>();
        int maxLength = 0;

        for (Edge e : edgeList) {
            if (ds.find(e.src) != ds.find(e.dest)) {
                ds.union(e.src, e.dest);
                String srcName = indexToName.get(e.src);
                String destName = indexToName.get(e.dest);
                if (srcName.compareTo(destName) > 0) {
                    String temp = srcName;
                    srcName = destName;
                    destName = temp;
                }
                String connection = srcName + "---" + destName;
                chosenEdges.add(new String[]{connection, String.valueOf(e.weight)});
                maxLength = Math.max(maxLength, connection.length());

                totalCost += e.weight;
                count++;
                if (count == indexToName.size() - 1)
                    break;
            }
        }

        // Second pass: build output with proper spacing
        for (String[] edge : chosenEdges) {
            String connection = edge[0];
            String weight = edge[1];
            int spacesToAdd = maxLength - connection.length();

            sb.append(connection);
            for (int i = 0; i < spacesToAdd; i++) {
                sb.append(" ");
            }
            sb.append(" $").append(weight).append("\n");
        }

        sb.append("The cost of the railroad is $").append(totalCost).append(".");
        return sb.toString();
    }


    private int getIndex(String name) {
        if (!nameToIndex.containsKey(name)) {
            nameToIndex.put(name, indexToName.size());
            indexToName.add(name);
        }
        return nameToIndex.get(name);
    }

    private class Edge implements Comparable<Edge> {
        int src, dest, weight;

        Edge(int src, int dest, int weight) {
            this.src = src;
            this.dest = dest;
            this.weight = weight;
        }

        public int compareTo(Edge other) {
            return this.weight - other.weight;
        }
    }

    private class DisjointSet {
        int[] parent, rank;

        public DisjointSet(int size) {
            parent = new int[size];
            rank = new int[size];
            for (int i = 0; i < size; i++) {
                parent[i] = i;
            }
        }

        public int find(int x) {
            if (parent[x] != x)
                parent[x] = find(parent[x]);
            return parent[x];
        }

        public void union(int x, int y) {
            int xRoot = find(x);
            int yRoot = find(y);
            if (xRoot == yRoot) return;
            if (rank[xRoot] < rank[yRoot]) {
                parent[xRoot] = yRoot;
            } else if (rank[xRoot] > rank[yRoot]) {
                parent[yRoot] = xRoot;
            } else {
                parent[yRoot] = xRoot;
                rank[xRoot]++;
            }
        }
    }
} 
